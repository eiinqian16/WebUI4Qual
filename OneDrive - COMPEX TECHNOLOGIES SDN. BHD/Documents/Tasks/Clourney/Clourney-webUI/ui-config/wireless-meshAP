config wifi-device 'radio0'
        option type 'mac80211'
        option path 'platform/soc/800000.wpu_b'
        option channel '1'
        option country 'CN'
        option band '2g'
        option htmode 'HE20'
        option txpower_ratio '100'

config wifi-dualband 'dualband'

config wifi-iface 'wifinet0_1'
        option device 'radio0'
        option mode 'ap'
        option ssid 'fronthaul-2g'
        option encryption 'psk2'
        option network 'lan'
        option multi_ap_backhaul_ssid 'backhaul-2g'
        option multi_ap '2'
        option bss_transition '1'
        option rrm_neighbor_report '1'
        option key '12345678'
        option wps_pushbutton '1'
        option multi_ap_backhaul_key '123456789'

config wifi-device 'radio1'
        option type 'mac80211'
        option path 'platform/soc/800000.wpu_b+1'
        option channel '36'
        option country 'CN'
        option band '5g'
        option htmode 'HE160'
        list channels '36-64'
        list channels '149-165'
        option txpower_ratio '100'

config wifi-iface 'wifnet0_2'
        option device 'radio0'
        option network 'lan'
        option mode 'ap'
        option ssid 'backhaul-2g'
        option encryption 'psk2'
        option multi_ap '1'
        option bss_transition '1'
        option rrm_neighbor_report '1'
        option wds '1'
        option key '123456789'

config wifi-iface 'wifinet1_1'
        option device 'radio1'
        option mode 'ap'
        option ssid 'fronthaul-5g'
        option encryption 'psk2'
        option network 'lan'
        option multi_ap_backhaul_ssid 'backhaul-5g'
        option multi_ap '2'
        option bss_transition '1'
        option rrm_neighbor_report '1'
        option key '12345678'
        option wps_pushbutton '1'
        option multi_ap_backhaul_key '123456789'

config wifi-iface 'wifnet1_2'
        option device 'radio1'
        option network 'lan'
        option mode 'ap'
        option ssid 'backhaul-5g'
        option encryption 'psk2'
        option multi_ap '1'
        option bss_transition '1'
        option rrm_neighbor_report '1'
        option wds '1'
        option key '123456789'

config globals 'globals'
