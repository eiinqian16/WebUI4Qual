
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/800000.wpu_b'
	option channel '1'
	option country 'CN'
	option band '2g'
	option htmode 'HE20'
	option txpower_ratio '100'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Clourney'
	option encryption 'none'
	option key '12345678'
	option wps_pushbutton '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc/800000.wpu_b+1'
	option channel '36'
	option country 'CN'
	option band '5g'
	option htmode 'HE160'
	list channels '36-64'
	list channels '149-165'
	option txpower_ratio '100'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'Clourney-5G'
	option encryption 'none'
	option key '12345678'
	option wps_pushbutton '1'

config wifi-iface 'station_iface'
	option device 'radio1'
	option network 'lan'
	option ifname 'wlan1-sta'
	option mode 'sta'
	option ssid 'Clourney_RootAP'
	option encryption 'none'
	option disabled '1'

config globals 'globals'

